# ---------------------------------------------------------------------------
# Secrets - never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# Local secrets for `act` (see .github/act.secrets.example)
.secrets
.secrets.*
!.github/act.secrets.example

# Credentials that sometimes get dropped into a repo by accident
*.p12
*.pfx
credentials.json
service-account*.json
.aws/

