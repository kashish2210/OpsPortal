# Normalise line endings so shell scripts stay LF-only inside Linux containers.
* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf
*.conf      text eol=lf
*.inc       text eol=lf

*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
