# ---------------------------------------------------------------------------
# OpsPortal backend - environment variables (for running WITHOUT Docker)
#
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# Docker Compose reads the repository-root .env instead; see ../.env.example
# Never commit the resulting .env.
# ---------------------------------------------------------------------------

# -- core -------------------------------------------------------------------
DEBUG=True
SECRET_KEY=dev-only-change-me-to-50-random-characters
ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
TIME_ZONE=Asia/Kolkata

# -- database ---------------------------------------------------------------
# Leave empty to fall back to a local SQLite file (zero setup).
# Postgres:  postgres://USER:PASSWORD@HOST:5432/DBNAME
# MySQL:     mysql://USER:PASSWORD@HOST:3306/DBNAME
DATABASE_URL=

# -- frontend / CORS --------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CORS_ALLOW_ALL_ORIGINS=False

# -- JWT --------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# -- auth behaviour ---------------------------------------------------------
SIGNUP_OPEN=True
REQUIRE_EMAIL_VERIFICATION=False

# -- e-mail / SMTP ----------------------------------------------------------
# Outside Docker the console backend is the least friction: password-reset and
# verification e-mails are printed straight to the runserver output.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=OpsPortal <no-reply@opsportal.local>
SERVER_EMAIL=OpsPortal <no-reply@opsportal.local>
#
# To point at the Mailpit container while running Django on the host:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=localhost
#   EMAIL_PORT=1025
#   EMAIL_USE_TLS=False
# then open the inbox at http://localhost:8025
#
# See ../.env.example for ready-made Brevo / SendGrid / SES / Gmail blocks.

# -- S3 media storage (bonus) -----------------------------------------------
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ENDPOINT_URL=

# -- company details printed on the challan PDF -----------------------------
COMPANY_NAME=Fundsroom Distribution Pvt Ltd
COMPANY_ADDRESS=Unit 4, Trade Centre, Andheri East, Mumbai 400059
COMPANY_GSTIN=27AAPFU0939F1ZV
COMPANY_PHONE=+91 22 4000 1234
COMPANY_EMAIL=accounts@fundsroom.local

# -- tests ------------------------------------------------------------------
# CI sets these to emit JUnit XML for the PR test report.
# TEST_RUNNER=xmlrunner.extra.djangotestrunner.XMLTestRunner
# TEST_OUTPUT_DIR=test-results

# -- production hardening ---------------------------------------------------
SECURE_SSL_REDIRECT=False

# -- demo data --------------------------------------------------------------
SEED_DEMO_DATA=True
