# ---------------------------------------------------------------------------
# OpsPortal - Docker Compose environment
#
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# Every value has a working default in docker-compose.yml, so `docker compose
# up --build` works without this file. Copy it when you want to change ports,
# credentials or feature flags.
#
# NEVER commit the resulting .env - it is gitignored for a reason.
# ---------------------------------------------------------------------------

# -- ports ------------------------------------------------------------------
APP_PORT=8080            # the whole app (nginx): http://localhost:8080
BACKEND_PORT=8000        # Django directly, handy for Postman
POSTGRES_PORT=5432       # postgres, for a local DB client
MAILPIT_UI_PORT=8025     # Mailpit web inbox: http://localhost:8025
MAILPIT_SMTP_PORT=1025   # Mailpit SMTP listener

# -- database ---------------------------------------------------------------
POSTGRES_DB=opsportal
POSTGRES_USER=opsportal
POSTGRES_PASSWORD=opsportal

# -- Django -----------------------------------------------------------------
DEBUG=False
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-only-secret-change-me-0123456789abcdef
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
FRONTEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
TIME_ZONE=Asia/Kolkata

# -- auth -------------------------------------------------------------------
SIGNUP_OPEN=True
REQUIRE_EMAIL_VERIFICATION=False
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ---------------------------------------------------------------------------
# SMTP
# ---------------------------------------------------------------------------
# Default: real SMTP against the bundled Mailpit container. Every outgoing
# message (password resets, e-mail verification) lands in the web inbox at
# http://localhost:8025 - nothing leaves your machine.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=OpsPortal <no-reply@opsportal.local>
SERVER_EMAIL=OpsPortal <no-reply@opsportal.local>

# --- Production providers: uncomment ONE block and fill in the credentials ---
#
# Brevo (Sendinblue) - 300 free e-mails/day
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-login@smtp-brevo.com
# EMAIL_HOST_PASSWORD=your-smtp-key
# EMAIL_USE_TLS=True
#
# SendGrid - the username is the literal string "apikey"
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=SG.your-api-key
# EMAIL_USE_TLS=True
#
# Amazon SES
# EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-ses-smtp-username
# EMAIL_HOST_PASSWORD=your-ses-smtp-password
# EMAIL_USE_TLS=True
#
# Gmail - requires an App Password, not your account password
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# EMAIL_USE_TLS=True

# ---------------------------------------------------------------------------
# Object storage for media (bonus) - product images and avatars
# ---------------------------------------------------------------------------
# Off by default: files go to the local `media_files` Docker volume.
# Works with Amazon S3 or any S3-compatible provider. Full walkthrough with
# screenshots-worth-of-detail in docs/ENVIRONMENT.md.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ENDPOINT_URL=

# --- Cloudflare R2 (recommended: 10 GB free, and zero egress fees) ----------
# Unlike S3 there is no 12-month clock and no bandwidth bill. Uncomment and
# fill in the three values from the Cloudflare dashboard:
#
# USE_S3=True
# AWS_ACCESS_KEY_ID=<R2 Access Key ID>
# AWS_SECRET_ACCESS_KEY=<R2 Secret Access Key>
# AWS_STORAGE_BUCKET_NAME=opsportal-media
# AWS_S3_REGION_NAME=auto                                  # R2 requires literally "auto"
# AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#
# Serving the images publicly (optional). Without this, URLs are pre-signed
# and expire after AWS_QUERYSTRING_EXPIRE seconds, which still works fine.
# Enable the bucket's r2.dev subdomain (or attach a custom domain), then:
# AWS_S3_CUSTOM_DOMAIN=pub-<hash>.r2.dev
# AWS_QUERYSTRING_AUTH=False

# --- Backblaze B2 (10 GB free) ---------------------------------------------
# AWS_S3_ENDPOINT_URL=https://s3.<region>.backblazeb2.com
# AWS_S3_REGION_NAME=<region>                              # e.g. us-west-004

# -- company details printed on the challan PDF -----------------------------
COMPANY_NAME=Fundsroom Distribution Pvt Ltd
COMPANY_ADDRESS=Unit 4, Trade Centre, Andheri East, Mumbai 400059
COMPANY_GSTIN=27AAPFU0939F1ZV
COMPANY_PHONE=+91 22 4000 1234
COMPANY_EMAIL=accounts@fundsroom.local

# -- demo data --------------------------------------------------------------
# Creates the four role logins plus sample customers, products and challans.
SEED_DEMO_DATA=True

# -- production only --------------------------------------------------------
SECURE_SSL_REDIRECT=False
