# ---------------------------------------------------------------------------
# Secrets for local `act` runs.
#
#   cp .github/act.secrets.example .secrets
#
# .secrets is gitignored. For local dry-runs, leaving GITHUB_TOKEN blank is
# fine. Only set a real token if you want the PR comment steps to post back to
# GitHub on an actual pull request.
# ---------------------------------------------------------------------------

# Leave this blank for a normal local run.
# Set a real PAT only if you want to exercise GitHub API calls.
GITHUB_TOKEN=

# Only used by the CD workflow's deploy job.
RENDER_DEPLOY_HOOK_URL=
