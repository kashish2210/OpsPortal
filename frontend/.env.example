# ---------------------------------------------------------------------------
# OpsPortal frontend - build-time environment variables
# Copy to `.env` (or `.env.local`) when developing outside Docker.
# ---------------------------------------------------------------------------

# Base URL of the REST API.
# Leave empty to use same-origin requests (`/api/...`), which is what both the
# Vite dev proxy and the nginx container do. Set an absolute URL only when the
# API lives on a different host, e.g. https://opsportal-api.onrender.com
VITE_API_BASE_URL=

# Where the Django-rendered auth pages live (login, signup, password reset).
# Same rule: empty means same-origin.
VITE_DJANGO_BASE_URL=

# Dev-only: where `npm run dev` proxies /api, /accounts, /admin, /static, /media
VITE_PROXY_TARGET=http://127.0.0.1:8000
